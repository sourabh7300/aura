# Copy to .env (never commit .env) or set these in Render → Environment.

# MODULE 2 — primary provider (Groq, OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MODULE 2 — failover provider, and MODULE 3 vision descriptions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Live information (sports, esports, news, current affairs)
# Add _2 … _10 for a key bank; comma lists are accepted too.
TAVILY_API_KEY=

# CORS: comma-separated origins, or * for a public demo
ALLOWED_ORIGINS=*

# Storage (SQLite + Chroma live here)
AURA_DATA_DIR=./data

# Set to 0 to skip ChromaDB and use the dependency-free SQLite index
AURA_USE_CHROMA=1
