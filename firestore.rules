rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* helpers ----------------------------------------------------------------
       AURORA writes through the backend (Firebase Admin SDK), which bypasses
       rules entirely — so everything below protects the DATA from the world,
       not the app from itself. Least privilege: your own doc, a public config,
       nothing else. */
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    /* role is SET only through the backend (Admin SDK). A client can never write
       a role for itself — not on create, not on update. */
    function role() {
      return request.auth.token.role
          || get(/databases/$(database)/documents/aura_users/$(request.auth.uid)).data.role;
    }
    function isStaff() {
      return signedIn() && (role() in ['maker', 'ceo']);
    }
    /* a write may not introduce a role field of its own */
    function noNewRole() {
      return !('role' in request.resource.data) || request.resource.data.role == null;
    }

    /* ---- your own user doc: only you read it; roles never come from you ---- */
    match /aura_users/{uid} {
      allow get, list: if isSelf(uid) || isStaff();
      /* create: request.resource is the NEW doc — never touch resource.data here */
      allow create: if isSelf(uid) && noNewRole();
      /* update: the role must be unchanged, and no key may become a role */
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false; /* deletion goes through the backend only */
    }

    /* ---- public config: everyone reads, only the staff (backend) writes ---- */
    match /aura_config/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---- everything else: closed (the squad's memory lives here and is only
            ever touched by the Admin SDK) ---- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
